# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète, ne JAMAIS exposer côté client (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard > Developers > Webhooks > ta webhook > "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs des prix créés dans Dashboard > Product catalog
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# --- App ---
# URL publique du site (http://localhost:3000 en local, https://ton-site.vercel.app en prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
